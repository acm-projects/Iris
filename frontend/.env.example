# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Where email links (confirmation, password reset) return to the app.
VITE_SUPABASE_REDIRECT_URL=iris://auth/callback
# Name the Google token Edge Function was deployed under
# (code: backend/supabase/functions/google-calendar-token).
VITE_GOOGLE_TOKEN_FUNCTION=google-calendar-token
